SuperStrict

Rem
bbdoc: Compact bitmap fonts and allocation-free display text rendering.
about: Fonts use the Embedded Bitmap Font version 1 format generated by the
bdf2embeddedfont tool. Glyphs are looked up by Unicode code point and rendered
directly into a TDisplayBuffer without allocating while drawing.
End Rem
Module Embedded.Drivers.Display.Font
?embedded

ModuleInfo "Version: 0.1"
ModuleInfo "License: zlib/libpng"

Import Embedded.Drivers.Display

Rem
bbdoc: The Embedded Bitmap Font data-format version accepted by TBitmapFont.
End Rem
Const EmbeddedBitmapFontVersion:Int = 1

Rem
bbdoc: Aligns wrapped text against the left edge of its text box.
End Rem
Const EmbeddedTextAlignLeft:Int = 0

Rem
bbdoc: Centers each wrapped line within its text box.
End Rem
Const EmbeddedTextAlignCenter:Int = 1

Rem
bbdoc: Aligns wrapped text against the right edge of its text box.
End Rem
Const EmbeddedTextAlignRight:Int = 2

Private

Function FontU16:Int(data:Byte Ptr, offset:Int)
	Return (Int(data[offset]) & $ff) | ((Int(data[offset + 1]) & $ff) Shl 8)
End Function

Function FontS16:Int(data:Byte Ptr, offset:Int)
	Local value:Int = FontU16(data, offset)
	If value & $8000 Then value :- $10000
	Return value
End Function

Function FontU32:UInt(data:Byte Ptr, offset:Int)
	Return UInt(Int(data[offset]) & $ff) | ..
		(UInt(Int(data[offset + 1]) & $ff) Shl 8) | ..
		(UInt(Int(data[offset + 2]) & $ff) Shl 16) | ..
		(UInt(Int(data[offset + 3]) & $ff) Shl 24)
End Function

Function FontS8:Int(data:Byte Ptr, offset:Int)
	Local value:Int = Int(data[offset]) & $ff
	If value & $80 Then value :- $100
	Return value
End Function

Function FontNextCodePoint:UInt(text:String, index:Int Var)
	If index >= text.length Then Return 0
	Local first:UInt = UInt(text[index])
	index :+ 1
	If first >= $d800 And first <= $dbff And index < text.length Then
		Local second:UInt = UInt(text[index])
		If second >= $dc00 And second <= $dfff Then
			index :+ 1
			Return $10000 + ((first - $d800) Shl 10) + (second - $dc00)
		End If
	End If
	If first >= $d800 And first <= $dfff Then Return $fffd
	Return first
End Function

Public

Rem
bbdoc: A read-only bitmap font stored in firmware.
about: DrawText treats x and y as the top-left corner of the first line. Newline
characters advance by LineHeight. Integer scaling enlarges pixels without
requiring another copy of the font data.
End Rem
Type TBitmapFont
	Private
	Field data:Byte Ptr
	Field dataLength:Int
	Field glyphCount:Int
	Field fontAscent:Int
	Field fontDescent:Int
	Field fontLineHeight:Int
	Field defaultCodePoint:UInt
	Field recordsOffset:Int
	Field bitmapsOffset:Int
	Field recordSize:Int
	Field asciiGlyphStart:Int

	Public
	Rem
	bbdoc: Opens an Embedded Bitmap Font image held in persistent memory.
	param: A pointer to the first byte of EBF1 font data.
	param: The available data length in bytes.
	returns: A validated read-only font, or Null when the data is invalid.
	End Rem
	Function Create:TBitmapFont(data:Byte Ptr, length:Int)
		If data = Null Or length < 32 Then Return Null
		If (Int(data[0]) & $ff) <> Asc("E") Or (Int(data[1]) & $ff) <> Asc("B") Or ..
			(Int(data[2]) & $ff) <> Asc("F") Or (Int(data[3]) & $ff) <> Asc("1") Then Return Null
		If FontU16(data, 4) <> EmbeddedBitmapFontVersion Then Return Null
		Local count:Int = Int(FontU32(data, 8))
		Local size:Int = FontU16(data, 18)
		Local records:Int = Int(FontU32(data, 24))
		Local bitmaps:Int = Int(FontU32(data, 28))
		If count <= 0 Or size < 16 Or records < 32 Or bitmaps < records Or ..
			records + count * size > bitmaps Or bitmaps > length Then Return Null
		Local result:TBitmapFont = New TBitmapFont
		result.data = data
		result.dataLength = length
		result.glyphCount = count
		result.fontAscent = FontS16(data, 12)
		result.fontDescent = FontS16(data, 14)
		result.fontLineHeight = FontU16(data, 16)
		result.recordSize = size
		result.defaultCodePoint = FontU32(data, 20)
		result.recordsOffset = records
		result.bitmapsOffset = bitmaps
		result.asciiGlyphStart = -1
		If result.fontLineHeight <= 0 Then Return Null
		Local asciiStart:Int = result.FindGlyph(32, False)
		If asciiStart >= 0 And asciiStart + 94 < count Then
			Local contiguous:Int = True
			For Local asciiOffset:Int = 0 Until 95
				If FontU32(data, result.GlyphRecordOffset(asciiStart + asciiOffset)) <> ..
						UInt(32 + asciiOffset) Then
					contiguous = False
					Exit
				End If
			Next
			If contiguous Then result.asciiGlyphStart = asciiStart
		End If
		Return result
	End Function

	Rem
	bbdoc: Returns the number of glyph records stored in this font.
	returns: The glyph count.
	End Rem
	Method GlyphCount:Int()
		Return glyphCount
	End Method

	Rem
	bbdoc: Returns the font ascent above its baseline.
	returns: The ascent in unscaled pixels.
	End Rem
	Method Ascent:Int()
		Return fontAscent
	End Method

	Rem
	bbdoc: Returns the font descent below its baseline.
	returns: The descent in unscaled pixels.
	End Rem
	Method Descent:Int()
		Return fontDescent
	End Method

	Rem
	bbdoc: Returns the distance between adjacent text lines.
	returns: The line height in unscaled pixels.
	End Rem
	Method LineHeight:Int()
		Return fontLineHeight
	End Method

	Rem
	bbdoc: Tests whether the font contains an exact Unicode glyph.
	param: The Unicode code point to locate.
	returns: True when an exact glyph exists; the default fallback is not considered.
	End Rem
	Method HasGlyph:Int(codePoint:UInt)
		Return FindGlyph(codePoint, False) >= 0
	End Method

	Rem
	bbdoc: Returns the maximum line width in pixels for text at an integer scale.
	param: The UTF-8 text to measure.
	param: The positive integer pixel scale.
	returns: The width of the widest line, or zero for an invalid scale.
	End Rem
	Method TextWidth:Int(text:String, scale:Int = 1)
		If scale <= 0 Then Return 0
		Local index:Int
		Local lineWidth:Int
		Local maximum:Int
		While index < text.length
			Local codePoint:UInt = FontNextCodePoint(text, index)
			If codePoint = 13 Then Continue
			If codePoint = 10 Then
				If lineWidth > maximum Then maximum = lineWidth
				lineWidth = 0
				Continue
			End If
			Local glyph:Int = FindGlyph(codePoint, True)
			If glyph >= 0 Then lineWidth :+ GlyphByte(glyph, 12) * scale
		Wend
		If lineWidth > maximum Then maximum = lineWidth
		Return maximum
	End Method

	Rem
	bbdoc: Draws text into a display buffer and returns the final pen x position.
	param: The destination raster buffer.
	param: The UTF-8 text to draw.
	param: The left coordinate of the first line.
	param: The top coordinate of the first line.
	param: The $RRGGBB glyph color.
	param: The positive integer pixel scale.
	returns: The x coordinate immediately following the final glyph.
	about: Rendering is transparent. Missing code points use the BDF default glyph
	when one is available. Carriage returns are ignored and newlines reset the pen
	to x and advance one scaled line.
	End Rem
	Method DrawText:Int(target:TDisplayBuffer, text:String, x:Int, y:Int, ..
			color:UInt = $ffffff, scale:Int = 1)
		If Not target Then Return x
		Return DrawTextClipped(target, text, x, y, color, scale, ..
			0, 0, target.Width(), target.Height())
	End Method

	Rem
	bbdoc: Draws text while restricting changed pixels to the supplied rectangle.
	param: The destination raster buffer.
	param: The UTF-8 text to draw.
	param: The left coordinate of the first line.
	param: The top coordinate of the first line.
	param: The $RRGGBB glyph color.
	param: The positive integer pixel scale.
	param: The clipping rectangle's left edge.
	param: The clipping rectangle's top edge.
	param: The clipping rectangle's width.
	param: The clipping rectangle's height.
	returns: The x coordinate immediately following the final glyph.
	about: The clipping rectangle is expressed in target-buffer coordinates and
	does not affect text measurement or the returned final pen position.
	End Rem
	Method DrawTextClipped:Int(target:TDisplayBuffer, text:String, x:Int, y:Int, ..
			color:UInt, scale:Int, clipX:Int, clipY:Int, clipWidth:Int, clipHeight:Int)
		If Not target Or scale <= 0 Then Return x
		If clipWidth <= 0 Or clipHeight <= 0 Then Return x
		Local clipX1:Int = clipX + clipWidth
		Local clipY1:Int = clipY + clipHeight
		If clipX < 0 Then clipX = 0
		If clipY < 0 Then clipY = 0
		If clipX1 > target.Width() Then clipX1 = target.Width()
		If clipY1 > target.Height() Then clipY1 = target.Height()
		If clipX >= clipX1 Or clipY >= clipY1 Then Return x
		Local index:Int
		Local penX:Int = x
		Local penY:Int = y
		While index < text.length
			Local codePoint:UInt = FontNextCodePoint(text, index)
			If codePoint = 13 Then Continue
			If codePoint = 10 Then
				penX = x
				penY :+ fontLineHeight * scale
				Continue
			End If
			Local glyph:Int = FindGlyph(codePoint, True)
			If glyph < 0 Then Continue
			DrawGlyph(target, glyph, penX, penY, color, scale, ..
				clipX, clipY, clipX1, clipY1)
			penX :+ GlyphByte(glyph, 12) * scale
		Wend
		Return penX
	End Method

	Rem
	bbdoc: Measures word-wrapped text without allocating temporary strings.
	param: The UTF-8 text to measure.
	param: The maximum line width in pixels.
	param: Receives the widest resulting line.
	param: Receives the total height of the resulting lines.
	param: The positive integer pixel scale.
	returns: The number of resulting lines.
	End Rem
	Method TextBoxSize:Int(text:String, width:Int, measuredWidth:Int Var, ..
			measuredHeight:Int Var, scale:Int = 1)
		measuredWidth = 0
		measuredHeight = 0
		If scale <= 0 Or width <= 0 Or text.length = 0 Then Return 0
		Local index:Int
		Local lines:Int
		While index < text.length
			Local lineStart:Int
			Local lineEnd:Int
			Local lineWidth:Int
			If Not NextWrappedLine(text, index, width, scale, lineStart, lineEnd, lineWidth) Then Exit
			If lineWidth > measuredWidth Then measuredWidth = lineWidth
			lines :+ 1
		Wend
		measuredHeight = lines * fontLineHeight * scale
		Return lines
	End Method

	Rem
	bbdoc: Draws aligned, word-wrapped text inside a fixed rectangle.
	param: The destination raster buffer.
	param: The UTF-8 text to draw.
	param: The text-box left coordinate.
	param: The text-box top coordinate.
	param: The text-box width in pixels.
	param: The text-box height in pixels.
	param: The $RRGGBB glyph color.
	param: An EmbeddedTextAlign value.
	param: The positive integer pixel scale.
	param: True to add an ellipsis when text exceeds the available lines.
	param: The clipping rectangle's left edge.
	param: The clipping rectangle's top edge.
	param: The clipping rectangle's width.
	param: The clipping rectangle's height.
	about: When ellipsis is true and more text remains after the last visible
	line, that line is shortened as required and three dots are appended. The
	operation scans the original string directly and does not allocate substrings.
	returns: The number of lines drawn.
	End Rem
	Method DrawTextBoxClipped:Int(target:TDisplayBuffer, text:String, x:Int, y:Int, ..
			width:Int, height:Int, color:UInt, alignment:Int, scale:Int, ellipsis:Int, ..
			clipX:Int, clipY:Int, clipWidth:Int, clipHeight:Int)
		If Not target Or scale <= 0 Or width <= 0 Or height <= 0 Then Return 0
		Local lineHeight:Int = fontLineHeight * scale
		Local maximumLines:Int = height / lineHeight
		If maximumLines <= 0 Then Return 0
		Local index:Int
		Local lines:Int
		While index < text.length And lines < maximumLines
			Local lineStart:Int
			Local lineEnd:Int
			Local lineWidth:Int
			If Not NextWrappedLine(text, index, width, scale, lineStart, lineEnd, lineWidth) Then Exit

			Local addEllipsis:Int = ellipsis And lines = maximumLines - 1 And index < text.length
			If addEllipsis Then
				Local dotsWidth:Int = TextWidth("...", scale)
				Local available:Int = width - dotsWidth
				If available < 0 Then available = 0
				Local fittedEnd:Int
				Local fittedWidth:Int
				FitRange(text, lineStart, lineEnd, available, scale, fittedEnd, fittedWidth)
				lineEnd = fittedEnd
				lineWidth = fittedWidth + dotsWidth
			End If

			Local penX:Int = x
			Select alignment
				Case EmbeddedTextAlignCenter
					penX :+ (width - lineWidth) / 2
				Case EmbeddedTextAlignRight
					penX :+ width - lineWidth
			End Select
			Local penY:Int = y + lines * lineHeight
			penX = DrawRangeClipped(target, text, lineStart, lineEnd, penX, penY, color, scale, ..
				clipX, clipY, clipWidth, clipHeight)
			If addEllipsis Then DrawTextClipped(target, "...", penX, penY, color, scale, ..
				clipX, clipY, clipWidth, clipHeight)
			lines :+ 1
		Wend
		Return lines
	End Method

	Private
	Method GlyphAdvance:Int(codePoint:UInt, scale:Int)
		Local glyph:Int = FindGlyph(codePoint, True)
		If glyph < 0 Then Return 0
		Return GlyphByte(glyph, 12) * scale
	End Method

	Method NextWrappedLine:Int(text:String, index:Int Var, maximumWidth:Int, scale:Int, ..
			lineStart:Int Var, lineEnd:Int Var, lineWidth:Int Var)
		While index < text.length And (text[index] = 32 Or text[index] = 9 Or text[index] = 13)
			index :+ 1
		Wend
		If index >= text.length Then Return False
		If text[index] = 10 Then
			lineStart = index
			lineEnd = index
			lineWidth = 0
			index :+ 1
			Return True
		End If
		lineStart = index
		Local scan:Int = index
		Local lastBreak:Int = -1
		Local lastBreakEnd:Int
		Local lastBreakWidth:Int
		While scan < text.length
			Local codeStart:Int = scan
			Local codePoint:UInt = FontNextCodePoint(text, scan)
			If codePoint = 13 Then Continue
			If codePoint = 10 Then
				lineEnd = codeStart
				index = scan
				Return True
			End If
			Local advance:Int = GlyphAdvance(codePoint, scale)
			If lineWidth + advance > maximumWidth Then
				If codeStart = lineStart Then
					lineWidth :+ advance
					lineEnd = scan
					index = scan
				Else If lastBreak >= 0 Then
					lineEnd = lastBreakEnd
					lineWidth = lastBreakWidth
					index = lastBreak
				Else
					lineEnd = codeStart
					index = codeStart
				End If
				Return True
			End If
			If codePoint = 32 Or codePoint = 9 Then
				lastBreak = scan
				lastBreakEnd = codeStart
				lastBreakWidth = lineWidth
			End If
			lineWidth :+ advance
		Wend
		lineEnd = scan
		index = scan
		Return True
	End Method

	Method FitRange(text:String, startIndex:Int, endIndex:Int, maximumWidth:Int, scale:Int, ..
			fittedEnd:Int Var, fittedWidth:Int Var)
		Local scan:Int = startIndex
		fittedEnd = startIndex
		fittedWidth = 0
		While scan < endIndex
			Local codePoint:UInt = FontNextCodePoint(text, scan)
			If codePoint = 13 Then Continue
			Local advance:Int = GlyphAdvance(codePoint, scale)
			If fittedWidth + advance > maximumWidth Then Exit
			fittedWidth :+ advance
			fittedEnd = scan
		Wend
	End Method

	Method DrawRangeClipped:Int(target:TDisplayBuffer, text:String, startIndex:Int, endIndex:Int, ..
			x:Int, y:Int, color:UInt, scale:Int, clipX:Int, clipY:Int, clipWidth:Int, clipHeight:Int)
		Local clipX1:Int = clipX + clipWidth
		Local clipY1:Int = clipY + clipHeight
		If clipX < 0 Then clipX = 0
		If clipY < 0 Then clipY = 0
		If clipX1 > target.Width() Then clipX1 = target.Width()
		If clipY1 > target.Height() Then clipY1 = target.Height()
		If clipX >= clipX1 Or clipY >= clipY1 Then Return x
		Local index:Int = startIndex
		Local penX:Int = x
		While index < endIndex
			Local codePoint:UInt = FontNextCodePoint(text, index)
			If codePoint = 13 Or codePoint = 10 Then Continue
			Local glyph:Int = FindGlyph(codePoint, True)
			If glyph < 0 Then Continue
			DrawGlyph(target, glyph, penX, y, color, scale, clipX, clipY, clipX1, clipY1)
			penX :+ GlyphByte(glyph, 12) * scale
		Wend
		Return penX
	End Method

	Method GlyphRecordOffset:Int(index:Int)
		Return recordsOffset + index * recordSize
	End Method

	Method GlyphByte:Int(index:Int, fieldOffset:Int)
		Return Int(data[GlyphRecordOffset(index) + fieldOffset]) & $ff
	End Method

	Method FindGlyph:Int(codePoint:UInt, useDefault:Int)
		If asciiGlyphStart >= 0 And codePoint >= 32 And codePoint <= 126 Then
			Return asciiGlyphStart + Int(codePoint - 32)
		End If
		Local low:Int
		Local high:Int = glyphCount - 1
		While low <= high
			Local middle:Int = low + ((high - low) Shr 1)
			Local found:UInt = FontU32(data, GlyphRecordOffset(middle))
			If found = codePoint Then Return middle
			If found < codePoint Then
				low = middle + 1
			Else
				high = middle - 1
			End If
		Wend
		If useDefault And codePoint <> defaultCodePoint Then Return FindGlyph(defaultCodePoint, False)
		Return -1
	End Method

	Method DrawGlyph(target:TDisplayBuffer, index:Int, penX:Int, lineTop:Int, ..
			color:UInt, scale:Int, clipX0:Int, clipY0:Int, clipX1:Int, clipY1:Int)
		Local record:Int = GlyphRecordOffset(index)
		Local bitmap:Int = bitmapsOffset + Int(FontU32(data, record + 4))
		Local width:Int = Int(data[record + 8]) & $ff
		Local height:Int = Int(data[record + 9]) & $ff
		Local xOffset:Int = FontS8(data, record + 10)
		Local yOffset:Int = FontS8(data, record + 11)
		Local stride:Int = Int(data[record + 13]) & $ff
		Local bitmapLength:Int = FontU16(data, record + 14)
		If width <= 0 Or height <= 0 Or stride <= 0 Or bitmap < bitmapsOffset Or ..
			bitmap + bitmapLength > dataLength Or stride * height > bitmapLength Then Return
		Local originX:Int = penX + xOffset * scale
		Local originY:Int = lineTop + (fontAscent - yOffset - height) * scale
		target.DrawMono1Mask(data + bitmap, stride, width, height, originX, originY, scale, ..
			clipX0, clipY0, clipX1 - clipX0, clipY1 - clipY0, color)
	End Method
End Type
?
