SuperStrict

Rem
bbdoc: Compact bitmap fonts and allocation-free display text rendering.
about: Fonts use the Embedded Bitmap Font version 1 format generated by the
bdf2embeddedfont tool. Glyphs are looked up by Unicode code point and rendered
directly into a TDisplayBuffer without allocating while drawing.
End Rem
Module Embedded.Drivers.Display.Font
?embedded

ModuleInfo "Version: 0.1"
ModuleInfo "License: zlib/libpng"

Import Embedded.Drivers.Display

Const EmbeddedBitmapFontVersion:Int = 1

Private

Function FontU16:Int(data:Byte Ptr, offset:Int)
	Return (Int(data[offset]) & $ff) | ((Int(data[offset + 1]) & $ff) Shl 8)
End Function

Function FontS16:Int(data:Byte Ptr, offset:Int)
	Local value:Int = FontU16(data, offset)
	If value & $8000 Then value :- $10000
	Return value
End Function

Function FontU32:UInt(data:Byte Ptr, offset:Int)
	Return UInt(Int(data[offset]) & $ff) | ..
		(UInt(Int(data[offset + 1]) & $ff) Shl 8) | ..
		(UInt(Int(data[offset + 2]) & $ff) Shl 16) | ..
		(UInt(Int(data[offset + 3]) & $ff) Shl 24)
End Function

Function FontS8:Int(data:Byte Ptr, offset:Int)
	Local value:Int = Int(data[offset]) & $ff
	If value & $80 Then value :- $100
	Return value
End Function

Function FontNextCodePoint:UInt(text:String, index:Int Var)
	If index >= text.length Then Return 0
	Local first:UInt = UInt(text[index])
	index :+ 1
	If first >= $d800 And first <= $dbff And index < text.length Then
		Local second:UInt = UInt(text[index])
		If second >= $dc00 And second <= $dfff Then
			index :+ 1
			Return $10000 + ((first - $d800) Shl 10) + (second - $dc00)
		End If
	End If
	If first >= $d800 And first <= $dfff Then Return $fffd
	Return first
End Function

Public

Rem
bbdoc: A read-only bitmap font stored in firmware.
about: DrawText treats x and y as the top-left corner of the first line. Newline
characters advance by LineHeight. Integer scaling enlarges pixels without
requiring another copy of the font data.
End Rem
Type TBitmapFont
	Private
	Field data:Byte Ptr
	Field dataLength:Int
	Field glyphCount:Int
	Field fontAscent:Int
	Field fontDescent:Int
	Field fontLineHeight:Int
	Field defaultCodePoint:UInt
	Field recordsOffset:Int
	Field bitmapsOffset:Int
	Field recordSize:Int

	Public
	Rem
	bbdoc: Opens an Embedded Bitmap Font image held in persistent memory.
	End Rem
	Function Create:TBitmapFont(data:Byte Ptr, length:Int)
		If data = Null Or length < 32 Then Return Null
		If (Int(data[0]) & $ff) <> Asc("E") Or (Int(data[1]) & $ff) <> Asc("B") Or ..
			(Int(data[2]) & $ff) <> Asc("F") Or (Int(data[3]) & $ff) <> Asc("1") Then Return Null
		If FontU16(data, 4) <> EmbeddedBitmapFontVersion Then Return Null
		Local count:Int = Int(FontU32(data, 8))
		Local size:Int = FontU16(data, 18)
		Local records:Int = Int(FontU32(data, 24))
		Local bitmaps:Int = Int(FontU32(data, 28))
		If count <= 0 Or size < 16 Or records < 32 Or bitmaps < records Or ..
			records + count * size > bitmaps Or bitmaps > length Then Return Null
		Local result:TBitmapFont = New TBitmapFont
		result.data = data
		result.dataLength = length
		result.glyphCount = count
		result.fontAscent = FontS16(data, 12)
		result.fontDescent = FontS16(data, 14)
		result.fontLineHeight = FontU16(data, 16)
		result.recordSize = size
		result.defaultCodePoint = FontU32(data, 20)
		result.recordsOffset = records
		result.bitmapsOffset = bitmaps
		If result.fontLineHeight <= 0 Then Return Null
		Return result
	End Function

	Method GlyphCount:Int()
		Return glyphCount
	End Method

	Method Ascent:Int()
		Return fontAscent
	End Method

	Method Descent:Int()
		Return fontDescent
	End Method

	Method LineHeight:Int()
		Return fontLineHeight
	End Method

	Method HasGlyph:Int(codePoint:UInt)
		Return FindGlyph(codePoint, False) >= 0
	End Method

	Rem
	bbdoc: Returns the maximum line width in pixels for text at an integer scale.
	End Rem
	Method TextWidth:Int(text:String, scale:Int = 1)
		If scale <= 0 Then Return 0
		Local index:Int
		Local lineWidth:Int
		Local maximum:Int
		While index < text.length
			Local codePoint:UInt = FontNextCodePoint(text, index)
			If codePoint = 13 Then Continue
			If codePoint = 10 Then
				If lineWidth > maximum Then maximum = lineWidth
				lineWidth = 0
				Continue
			End If
			Local glyph:Int = FindGlyph(codePoint, True)
			If glyph >= 0 Then lineWidth :+ GlyphByte(glyph, 12) * scale
		Wend
		If lineWidth > maximum Then maximum = lineWidth
		Return maximum
	End Method

	Rem
	bbdoc: Draws text into a display buffer and returns the final pen x position.
	about: Rendering is transparent. Missing code points use the BDF default glyph
	when one is available. Carriage returns are ignored and newlines reset the pen
	to x and advance one scaled line.
	End Rem
	Method DrawText:Int(target:TDisplayBuffer, text:String, x:Int, y:Int, ..
			color:UInt = $ffffff, scale:Int = 1)
		If Not target Or scale <= 0 Then Return x
		Local index:Int
		Local penX:Int = x
		Local penY:Int = y
		While index < text.length
			Local codePoint:UInt = FontNextCodePoint(text, index)
			If codePoint = 13 Then Continue
			If codePoint = 10 Then
				penX = x
				penY :+ fontLineHeight * scale
				Continue
			End If
			Local glyph:Int = FindGlyph(codePoint, True)
			If glyph < 0 Then Continue
			DrawGlyph(target, glyph, penX, penY, color, scale)
			penX :+ GlyphByte(glyph, 12) * scale
		Wend
		Return penX
	End Method

	Private
	Method GlyphRecordOffset:Int(index:Int)
		Return recordsOffset + index * recordSize
	End Method

	Method GlyphByte:Int(index:Int, fieldOffset:Int)
		Return Int(data[GlyphRecordOffset(index) + fieldOffset]) & $ff
	End Method

	Method FindGlyph:Int(codePoint:UInt, useDefault:Int)
		Local low:Int
		Local high:Int = glyphCount - 1
		While low <= high
			Local middle:Int = low + ((high - low) Shr 1)
			Local found:UInt = FontU32(data, GlyphRecordOffset(middle))
			If found = codePoint Then Return middle
			If found < codePoint Then
				low = middle + 1
			Else
				high = middle - 1
			End If
		Wend
		If useDefault And codePoint <> defaultCodePoint Then Return FindGlyph(defaultCodePoint, False)
		Return -1
	End Method

	Method DrawGlyph(target:TDisplayBuffer, index:Int, penX:Int, lineTop:Int, ..
			color:UInt, scale:Int)
		Local record:Int = GlyphRecordOffset(index)
		Local bitmap:Int = bitmapsOffset + Int(FontU32(data, record + 4))
		Local width:Int = Int(data[record + 8]) & $ff
		Local height:Int = Int(data[record + 9]) & $ff
		Local xOffset:Int = FontS8(data, record + 10)
		Local yOffset:Int = FontS8(data, record + 11)
		Local stride:Int = Int(data[record + 13]) & $ff
		Local bitmapLength:Int = FontU16(data, record + 14)
		If width <= 0 Or height <= 0 Or stride <= 0 Or bitmap < bitmapsOffset Or ..
			bitmap + bitmapLength > dataLength Or stride * height > bitmapLength Then Return
		Local originX:Int = penX + xOffset * scale
		Local originY:Int = lineTop + (fontAscent - yOffset - height) * scale
		For Local row:Int = 0 Until height
			For Local column:Int = 0 Until width
				Local packed:Int = Int(data[bitmap + row * stride + (column Shr 3)]) & $ff
				If Not (packed & ($80 Shr (column & 7))) Then Continue
				If scale = 1 Then
					target.SetPixel(originX + column, originY + row, color)
				Else
					target.FillRect(originX + column * scale, originY + row * scale, ..
						scale, scale, color)
				End If
			Next
		Next
	End Method
End Type
?
